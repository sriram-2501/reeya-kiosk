# MySQL (replaces Supabase/Postgres+pgvector -- see migrations_mysql/001_schema.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=reeya_kiosk

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Embedding backend: Gemini Embedding 2, hosted (see app/services/embeddings.py).
# Get a key from Google AI Studio (https://aistudio.google.com/apikey).
EMBEDDING_MODEL_NAME=gemini-embedding-2-preview
GEMINI_API_KEY=your-gemini-api-key

# Presigned upload URLs
PRESIGN_EXPIRY_SECONDS=300

# Teammate's product-image API (external dependency, see scripts/index_catalog.py)
PRODUCT_API_URL=https://reeyalifestyle.com/wp-json/reeya-kiosk/v1
PRODUCT_API_KEY=your-api-key

# Voice search: filter extraction from a transcript (see app/services/extract_filters.py)
OPENAI_API_KEY=your-openai-api-key

# Comma-separated list of frontend origins allowed to call this API.
# Only matters once frontend and backend are deployed on different domains.
# Now hosted on Hostinger (kiosk.reeyalifestyle.com), not Vercel -- the
# ALLOWED_ORIGIN_REGEX Vercel-preview fallback below no longer applies.
ALLOWED_ORIGINS=http://localhost:5173,https://kiosk.reeyalifestyle.com

# Only relevant if the frontend ever moves back to Vercel (preview
# deployments get a new random subdomain per push/PR that a fixed
# ALLOWED_ORIGINS list could never keep up with) -- leave unset otherwise.
ALLOWED_ORIGIN_REGEX=
